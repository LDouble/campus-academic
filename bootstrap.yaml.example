environment: development
release: dev

provider_config_file: provider-config.yaml

provider:
  listen_address: ":9090"
  insecure: true
  max_concurrent: 32
  queue_wait: 250ms
  retry_after: 2s

redis:
  address: 127.0.0.1:6379
  db: 0

academic_query:
  cache_mode: normal
  courses_timeout: 10s
  grades_timeout: 10s
  exams_timeout: 12s
  selections_timeout: 12s
  stale_refresh_timeout: 2s
  lease_ttl: 20s
  poll_interval: 100ms
  global_rate: 10
  global_burst: 20

analytics:
  listen_address: ":9091"
  insecure: true
  mysql:
    dsn: ""
  redis:
    address: 127.0.0.1:6380
    db: 0
  timezone: Asia/Shanghai
  schedule_hour: 4
  minimum_sample_size: 5
  query_timeout: 2m
  worker_concurrency: 2
  task_queue: academic_analytics
  task_timeout: 30m

observability:
  metrics_address: ":9300"
