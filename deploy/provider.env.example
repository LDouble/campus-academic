# Provider 与 Analytics 独立构建、独立发布；production 必须使用不可变摘要。
CAMPUS_ACADEMIC_PROVIDER_IMAGE=registry.example.com/campus-academic-provider@sha256:replace-me
CAMPUS_ACADEMIC_ANALYTICS_IMAGE=registry.example.com/campus-academic-analytics@sha256:replace-me
CAMPUS_ATRUST_IMAGE=registry.example.com/docker_weouc/campus-atrust-gateway@sha256:replace-me
CAMPUS_ATRUST_GATEWAY_HOME=/opt/campus-atrust-gateway

# Compose project 必须按环境和角色隔离。可在云效环境变量组覆盖为同一格式的节点后缀。
COMPOSE_PROJECT_NAME=campus-academic-production-provider
# 容器内 Provider 始终监听 9090；这里只控制宿主机发布端口。
CAMPUS_ACADEMIC_PROVIDER_PUBLISHED_PORT=9090

# 配置文件与凭据必须使用宿主机绝对路径，不得放入仓库。
CAMPUS_ACADEMIC_BOOTSTRAP_HOST_FILE=/etc/campus-academic/production/bootstrap.yaml
CAMPUS_ACADEMIC_PROVIDER_CONFIG_HOST_FILE=/etc/campus-academic/production/provider-config.yaml
CAMPUS_ACADEMIC_RPC_TLS_HOST_DIR=/etc/campus-academic/production/secrets/academic-rpc
CAMPUS_ACADEMIC_PROVIDER_REDIS_TLS_HOST_DIR=/etc/campus-academic/production/secrets/provider-redis
CAMPUS_ATRUST_USERNAME_FILE=/etc/campus-academic/production/secrets/atrust-username
CAMPUS_ATRUST_PASSWORD_FILE=/etc/campus-academic/production/secrets/atrust-password

# Provider 和 aTrust 仅通过同环境、同角色的外部客户端网络通信；不得使用无环境前缀的网络名。
CAMPUS_ATRUST_CLIENT_NETWORK=campus-production-atrust-clients
CAMPUS_ATRUST_EGRESS_NETWORK=campus-atrust-egress

# Provider 运行密钥和 Redis 等其余变量按 bootstrap.yaml 与 Compose 契约注入。
CAMPUS_ACADEMIC_PROVIDER_KEY=replace-me
CAMPUS_ACADEMIC_QUERY_KEY=replace-me
