# Analytics 独立主机环境文件。Review/Production 均建议填入解析后的不可变摘要；Production 强制要求。
CAMPUS_ACADEMIC_ANALYTICS_IMAGE=registry.example.com/campus-academic-analytics@sha256:replace-me

# Compose project 必须按环境和角色隔离。可在云效环境变量组覆盖为同一格式的节点后缀。
COMPOSE_PROJECT_NAME=campus-academic-production-analytics
# 容器内 Analytics 始终监听 9091；这里只控制宿主机发布端口。
CAMPUS_ACADEMIC_ANALYTICS_PUBLISHED_PORT=9091

# 这些文件与凭据仅存在于 Analytics 主机受控目录，不得提交到仓库或注入 Provider 主机。
CAMPUS_ACADEMIC_BOOTSTRAP_HOST_FILE=/etc/campus-academic/production/analytics/bootstrap.yaml
CAMPUS_ACADEMIC_RPC_TLS_HOST_DIR=/etc/campus-academic/production/analytics/secrets/academic-rpc
CAMPUS_ACADEMIC_ANALYTICS_REDIS_TLS_HOST_DIR=/etc/campus-academic/production/analytics/secrets/analytics-redis
CAMPUS_ACADEMIC_ANALYTICS_REDIS_CONFIG_HOST_FILE=/etc/campus-academic/production/analytics/redis.conf
# redis.conf 必须设置 port 0、tls-port 6379，并仅引用下面 TLS 根目录内的服务端证书、私钥和 CA。

CAMPUS_ACADEMIC_DB_PASSWORD=replace-me
CAMPUS_ACADEMIC_DB_ROOT_PASSWORD=replace-me
CAMPUS_ACADEMIC_ANALYTICS_SOURCE_DSN=replace-with-read-only-source-dsn
CAMPUS_ACADEMIC_ANALYTICS_REDIS_USERNAME=default
CAMPUS_ACADEMIC_ANALYTICS_REDIS_PASSWORD=replace-me
CAMPUS_ACADEMIC_ANALYTICS_REDIS_CA_FILE=ca.crt
CAMPUS_ACADEMIC_ANALYTICS_REDIS_CLIENT_CERT_FILE=
CAMPUS_ACADEMIC_ANALYTICS_REDIS_CLIENT_KEY_FILE=
CAMPUS_ACADEMIC_ANALYTICS_REDIS_SERVER_NAME=analytics-redis.internal
CAMPUS_ACADEMIC_ANALYTICS_BIND_ADDRESS=127.0.0.1
# 普通聚合故障的重试间隔；成绩源为空时不会按此间隔重试，而会等待下一次每日调度。
CAMPUS_ACADEMIC_ANALYTICS_RETRY_DELAY=15m
